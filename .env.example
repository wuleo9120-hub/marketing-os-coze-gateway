# Server
PORT=8787
HOST=127.0.0.1
LOCAL_API_WRITE_TOKEN=
MAX_JSON_BODY_BYTES=1048576
LOG_LEVEL=info
STORE_PATH=data/dev-store.json

# Coze plugin frontend gateway
COZE_PLUGIN_ENABLED=false
COZE_PLUGIN_TOKEN=
COZE_PUBLIC_BASE_URL=

# Production storage / runtime
STORE_ADAPTER=json
DATABASE_URL=
ENABLE_POSTGRES_STORE_ADAPTER=false
PGVECTOR_ENABLED=false
PSQL_BIN=psql
POSTGRES_MIGRATION_TIMEOUT_MS=30000
REDIS_URL=
QUEUE_CONCURRENCY=2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
SESSION_SECRET=
ADMIN_EMAILS=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
MULTI_TENANT_MODE=false
DEFAULT_WORKSPACE_ID=default

# Model providers
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT_MS=8000

# Codex GPT-5.5 supervised gateway is optional.
CODEX_MODEL=gpt-5.5
CODEX_GATEWAY_URL=
CODEX_GATEWAY_TOKEN=

# Hermes / external executor placeholders
HERMES_GATEWAY_URL=
OPENCLAW_BASE_URL=http://127.0.0.1:9292
MAX_HERMES_PROMPT_CHARS=16000
MAX_OPENCLAW_PAYLOAD_CHARS=16000

# OpenClaw HTTP bridge
OPENCLAW_BRIDGE_HOST=127.0.0.1
OPENCLAW_BRIDGE_PORT=9292
OPENCLAW_BRIDGE_AGENT_EXECUTION=false
OPENCLAW_BRIDGE_CLI_TIMEOUT_MS=5000

# Platform / messaging connectors
PLATFORM_CONNECTOR_URL=
WECOM_CONNECTOR_URL=

# Douyin Open Platform
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_DEFAULT_OPEN_ID=

# Xiaohongshu official/partner access, when available
XHS_APP_ID=
XHS_APP_SECRET=
XHS_PARTNER_TOKEN=

# WeChat Channels / WeChat ecosystem, when available
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SHOP_APP_ID=
WECHAT_SHOP_SECRET=

# WeCom customer contact
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_EXTERNAL_CONTACT_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_DEFAULT_USER_ID=
WECOM_CONTACT_WAY_CONFIG_ID=

# Personal WeChat assisted workflow, no unattended messaging
WEIXIN_PERSONAL_QR_URL=
WEIXIN_PERSONAL_QR_PATH=
WEIXIN_PERSONAL_ACCOUNT_LABEL=
