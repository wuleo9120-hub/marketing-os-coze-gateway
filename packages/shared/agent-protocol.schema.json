{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResult",
  "type": "object",
  "required": [
    "task_summary",
    "key_findings",
    "artifacts",
    "memory_updates",
    "next_actions",
    "risk_flags"
  ],
  "properties": {
    "task_summary": {
      "type": "string"
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "content", "importance"],
        "properties": {
          "type": {
            "enum": ["strategy", "brand", "content", "customer", "tool", "workflow"]
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

